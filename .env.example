# ── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Anthropic (AI Explanations) ───────────────────────────────────────────────
# Used in Supabase Edge Function only — NEVER expose in frontend
# Set via: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=sk-ant-your-key-here   ← server-side only

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_ENV=development   # development | production
